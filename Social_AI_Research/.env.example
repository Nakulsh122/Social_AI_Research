# Copy this file to `.env` and fill in. The extension talks to the SAIR
# backend (not Pangram directly) — the backend owns the Pangram key.
# After editing, run `npm run build` and reload the extension.

# Where the SAIR backend lives. For local development this is the FastAPI
# service started via `uvicorn main:app --port 8765`. For production this
# will be the public HTTPS URL once Apache proxy-pass is wired up.
BACKEND_URL=http://127.0.0.1:8765
