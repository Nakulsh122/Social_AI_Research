# Copy to `.env` and fill in. Never commit `.env`.

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sair

# ── Pangram (same key as the extension's .env) ───────────────────────────
PANGRAM_API_KEY=
PANGRAM_API_URL=https://text.api.pangram.com/v3

# ── FastAPI / Uvicorn ────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=info

# Minimum text length the backend will pass to Pangram (matches the
# extension-side threshold). Requests under this length are rejected.
MIN_TEXT_LENGTH=250

# ── Admin dashboard (researcher-facing) ──────────────────────────────────
# Single shared password protecting /admin/*. Set a long random string
# (e.g. `openssl rand -hex 32`). Anyone with this string has full read
# access to the dashboard and exports — share it only with the PI.
ADMIN_SECRET=

# ── Rate Limits ──────────────────────────────────────────────────────────
REGISTER_DAILY_LIMIT=500
SCORE_HOURLY_LIMIT=500
SCORE_DAILY_LIMIT=2000
OBSERVATIONS_HOURLY_LIMIT=1000
OBSERVATIONS_DAILY_LIMIT=5000

# ── Study Rounds / Cohorts ───────────────────────────────────────────────
# Default cohort assigned to new or re-registering participants (e.g. 1, 2, 3).
CURRENT_COHORT=1

# ── Data Export & Automation ─────────────────────────────────────────────
# Automatically exports the database every hour to a single replaced `exports.zip`.
# Enabled by default (set to 'false' only if you wish to disable automatic hourly saves).
ENABLE_HOURLY_EXPORT=true
EXPORT_INTERVAL_SECONDS=3600

# ── Phone Push Notifications (ntfy.sh) ──────────────────────────────────
# Install the free 'ntfy' app on your phone (iOS or Android) and subscribe
# to this topic name. When MongoDB goes down, you will receive an instant push notification.
NTFY_TOPIC=
ALERT_INTERVAL_SECONDS=30


